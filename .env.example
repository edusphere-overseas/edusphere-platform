# Copy to .env.local for local development. Never commit real values.
# Add the same keys in Netlify: Site configuration > Environment variables.

# Step 2: Sanity (content)
NEXT_PUBLIC_SANITY_PROJECT_ID=wuskruh6
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Step 3: Supabase (portal, Mumbai region)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Step 3: Cloudflare R2 (documents) and Turnstile (spam checks)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edusphere-documents
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Step 4: Resend (email)
RESEND_API_KEY=

# Step 6: Google reviews (Places API, New)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Step 2: instant updates when content is published (same secret on the Sanity webhook)
SANITY_REVALIDATE_SECRET=
