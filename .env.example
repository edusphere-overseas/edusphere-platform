# Portal settings. Put the real values in Vercel → Project Settings → Environment Variables
# (never in this file or the repository). The portal shows "opens soon" until the first two are set.

# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # server only: invitations, checked uploads, email look-ups

# Cloudflare R2 (private bucket for documents)
R2_ACCOUNT_ID=
R2_BUCKET=edusphere-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Turnstile (spam check on sign-up, sign-in and password reset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Show "Continue with Google" once Google sign-in is set up in Supabase
NEXT_PUBLIC_GOOGLE_SIGN_IN=on

# Resend (portal emails). EMAIL_FROM must use the domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Edusphere Overseas <portal@edusphereoverseas.com>
STAFF_EMAIL=                                # where staff notifications go until counsellors are assigned

# Optional: fixes the address used in emails (otherwise taken from Vercel's own settings)
# SITE_URL=https://www.edusphereoverseas.com
